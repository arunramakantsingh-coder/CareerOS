# CareerOS local development environment
# Copy this file to .env and fill provider credentials. Never commit the real .env.

# Optional frontend override. Leave blank to derive API host from the browser hostname.
FRONTEND_BASE_URL=http://localhost:3000

# Local AI / Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
INTELLIGENCE_TIMEOUT_SECONDS=180
INTELLIGENCE_EXECUTION_TIMEOUT_SECONDS=180

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth / profile connection
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
