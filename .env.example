# CareerOS local development environment
# Copy this file to .env and fill provider credentials. Never commit the real .env.

# Optional frontend override. Leave blank to derive API host from the browser hostname.
FRONTEND_BASE_URL=http://localhost:3000

# Intelligence provider
# Supported: ollama | openrouter | gemini
AI_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# OpenRouter (optional public provider)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Google Gemini API (optional public provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Intelligence request timeout (seconds)
INTELLIGENCE_TIMEOUT_SECONDS=90

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth / profile connection
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
