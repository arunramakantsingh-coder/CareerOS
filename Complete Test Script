Write-Host "🖥️ 5. FRONTEND" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

try {
    $response = Invoke-WebRequest -Uri "http://localhost:3000" -UseBasicParsing
    Write-Host "✅ Frontend: Status $($response.StatusCode)" -ForegroundColor Green
} catch {
    Write-Host "❌ Frontend FAILED" -ForegroundColor Red
}

# ============================================
# 6. DATABASE TABLES
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "🗄️ 6. DATABASE TABLES" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

try {
    $tables = docker compose exec postgres psql -U careeros -d careeros -c "\dt" 2>$null
    Write-Host "✅ Database tables:" -ForegroundColor Green
    Write-Host $tables -ForegroundColor White
} catch {
    Write-Host "❌ Database check FAILED" -ForegroundColor Red
}

# ============================================
# 7. API DOCS
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "📚 7. API DOCUMENTATION" -ForegroundColor Yellow
