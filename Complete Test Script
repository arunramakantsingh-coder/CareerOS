# ============================================
# 1. CONTAINER STATUS
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "📦 1. CONTAINER STATUS" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

docker compose ps

# ============================================
# 2. HEALTH CHECK
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "🏥 2. HEALTH CHECK" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

try {
    $response = Invoke-WebRequest -Uri "http://localhost:8000/api/v1/health" -UseBasicParsing
    Write-Host "✅ Health Check: $($response.Content)" -ForegroundColor Green
} catch {
    Write-Host "❌ Health Check FAILED" -ForegroundColor Red
}

