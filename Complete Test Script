Write-Host "  📖 Swagger UI: http://localhost:8000/docs" -ForegroundColor Cyan
Write-Host "  📖 ReDoc: http://localhost:8000/redoc" -ForegroundColor Cyan
Write-Host "  📖 OpenAPI: http://localhost:8000/openapi.json" -ForegroundColor Cyan

# ============================================
# 8. PERSONA API TEST
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "👤 8. PERSONA API TEST" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

$personaBody = @{
    user_id = "00000000-0000-0000-0000-000000000000"
    career_profile_id = "00000000-0000-0000-0000-000000000000"
    name = "Test Persona"
    description = "A test persona for API testing"
    is_active = $true
    target_titles = @("Network Architect", "Security Architect")
    target_industries = @("Technology", "Finance")
} | ConvertTo-Json

try {
    $response = Invoke-WebRequest -Uri "http://localhost:8000/api/v1/personas/" -Method POST -Body $personaBody -ContentType "application/json" -UseBasicParsing
    Write-Host "✅ Persona API: $($response.StatusCode)" -ForegroundColor Green
    Write-Host $response.Content -ForegroundColor White
} catch {
    Write-Host "⚠️ Persona API returned error (expected if no user exists)" -ForegroundColor Yellow
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Yellow
}

# ============================================
# 9. JOB SOURCE API TEST
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "📰 9. JOB SOURCE API TEST" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

$sourceBody = @{
    name = "Test Source"
    source_type = "test"
    is_active = $true
    is_system = $false
} | ConvertTo-Json

try {
    $response = Invoke-WebRequest -Uri "http://localhost:8000/api/v1/sources/" -Method POST -Body $sourceBody -ContentType "application/json" -UseBasicParsing
    Write-Host "✅ Job Source API: $($response.StatusCode)" -ForegroundColor Green
    Write-Host $response.Content -ForegroundColor White
} catch {
    Write-Host "⚠️ Job Source API returned error" -ForegroundColor Yellow
    Write-Host "   Error: $($_.Exception.Message)" -ForegroundColor Yellow
}

