# 3. API ROOT
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "📡 3. API ROOT" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

try {
    $response = Invoke-WebRequest -Uri "http://localhost:8000/" -UseBasicParsing
    Write-Host "✅ API Root: $($response.Content)" -ForegroundColor Green
} catch {
    Write-Host "❌ API Root FAILED" -ForegroundColor Red
}

# ============================================
# 4. PING
# ============================================
Write-Host "`n" + "="*60 -ForegroundColor Cyan
Write-Host "🏓 4. PING" -ForegroundColor Yellow
Write-Host "="*60 -ForegroundColor Cyan

try {
    $response = Invoke-WebRequest -Uri "http://localhost:8000/api/v1/ping" -UseBasicParsing
